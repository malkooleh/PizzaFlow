      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "manager123",
          "temporary": false
        }
      ],
      "realmRoles": ["RESTAURANT_MANAGER"]
    },
    {
      "username": "kitchen",
      "email": "kitchen@pizzaflow.local",
      "firstName": "Kitchen",
      "lastName": "Staff",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "kitchen123",
          "temporary": false
        }
      ],
      "realmRoles": ["KITCHEN_STAFF"]
    },
    {
      "username": "courier",
      "email": "courier@pizzaflow.local",
      "firstName": "Delivery",
      "lastName": "Courier",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "courier123",
          "temporary": false
        }
      ],
      "realmRoles": ["COURIER"]
    },
    {
      "username": "customer",
      "email": "customer@pizzaflow.local",
      "firstName": "Test",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customer123",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER"]
    }
  ],
  "clientScopeMappings": {
    "pizzaflow-api": [
      {
        "client": "pizzaflow-web",
        "roles": ["manage_orders", "view_orders"]
      },
      {
        "client": "pizzaflow-kds",
        "roles": ["view_orders"]
      }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "roles",
      "roles": ["CUSTOMER", "KITCHEN_STAFF", "COURIER", "RESTAURANT_MANAGER", "SYSTEM_ADMIN"]
    }
  ],
  "smtpServer": {},
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v2",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "uk"],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "REGISTER_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}

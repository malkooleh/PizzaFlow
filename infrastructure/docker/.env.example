# PizzaFlow Local Development Environment Variables
#
# Copy this file to .env in the same directory and fill in values.
# For local development, this file is required because docker-compose no longer
# contains insecure default credential fallbacks.
#
# NEVER commit a populated .env file to version control.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=admin

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Mail (SMTP)
MAIL_USERNAME=noreply@pizzaflow.com
MAIL_PASSWORD=

# Spring Datasource (used by services via config-server)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

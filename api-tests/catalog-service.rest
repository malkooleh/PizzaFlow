###############################################
# Error Cases
###############################################

### 16. Get Non-Existent Item (404)
GET {{baseUrl}}/items/000000000000000000000000
Accept: application/json

### 17. Get Menu for Non-Existent Restaurant (Empty)
GET {{baseUrl}}/menu/RESTAURANT-999
Accept: application/json

### 18. Invalid Category
GET {{baseUrl}}/menu/{{restaurantId}}/category/INVALID_CATEGORY
Accept: application/json

### 19. Create Item with Invalid Data (Validation Error)
POST {{baseUrl}}/items
Content-Type: application/json

{
  "restaurantId": "",
  "name": "",
  "category": "PIZZA",
  "basePrice": -10.00
}

